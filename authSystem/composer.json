{
    "name": "crauli/auth-system",
    "description": "Простая система регистрации и авторизации на PHP",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
